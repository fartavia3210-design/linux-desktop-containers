def ensure_docker_group_session() -> None:

    if shutil.which("docker") is None:
        return

    if shutil.which("sg") is None:
        return

    docker_check = subprocess.run(
        ["docker", "info"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False
    )

    if docker_check.returncode == 0:
        return

    try:
        docker_group = grp.getgrnam("docker")
        user = pwd.getpwuid(os.getuid())
    except KeyError:
        return

    current_gids = set(os.getgroups())
    current_gids.add(os.getgid())
    current_gids.add(os.getegid())

    try:
        configured_gids = set(
            os.getgrouplist(
                user.pw_name,
                user.pw_gid
            )
        )
    except OSError:
        return

    docker_gid = docker_group.gr_gid

    if docker_gid not in configured_gids:
        return

    if docker_gid in current_gids:
        return

    script = str(
        Path(__file__).resolve()
    )

    command = shlex.join(
        [
            sys.executable,
            script,
            *sys.argv[1:]
        ]
    )

    print(
        "La sesión actual todavía no tiene "
        "activo el grupo docker."
    )

    print(
        "Reiniciando Linux Desktop Containers "
        "con los permisos correctos..."
    )

    os.execvp(
        "sg",
        [
            "sg",
            "docker",
            "-c",
            command
        ]
    )


def clear() -> None:
    print("\033[2J\033[H", end="")


def pause() -> None:
    input("\nPresiona Enter para continuar...")


def header(title: str | None = None) -> None:
    clear()

    print("╔══════════════════════════════════════════╗")
    print("║        Linux Desktop Containers          ║")
    print("╚══════════════════════════════════════════╝")

    if title:
        print()
        print(title)

    print()


def choose(
    options: list[str],
    back_text: str = "Volver"
) -> int | None:

    for index, option in enumerate(
        options,
        start=1
    ):
        print(f"  {index}) {option}")

    print(f"  0) {back_text}")
    print()

    while True:
        value = input("> ").strip()

        if value == "0":
            return None

        if value.isdigit():
            index = int(value) - 1

            if 0 <= index < len(options):
                return index

        print("Opción inválida.")


def status_label(
    distro_key: str,
    desktop_key: str
) -> str:

    installation = get_installation_status(
        distro_key,
        desktop_key
    )

    if installation == "unavailable":
        return "🚧 Próximamente"

    if installation == "not-installed":
        return "📥 No instalado"

    if installation == "image-only":
        return "📦 Imagen descargada"

    desktop = get_desktop(
        distro_key,
        desktop_key
    )

    container_name = desktop[
        "container"
    ]["name"]

    status = get_status(
        container_name
    )

    if status == "running":
        return "🟢 Ejecutándose"

    return "🟡 Instalado"


