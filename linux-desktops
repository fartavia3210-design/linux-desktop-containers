        f"{status['python']['version']}"
    )

    print(
        f"Docker         "
        f"{'✅' if status['docker']['installed'] else '❌'} "
        f"{'(activo)' if status['docker']['running'] else '(detenido)'}"
    )

    print(
        f"Docker Buildx  "
        f"{'✅' if status['docker_buildx']['installed'] else '❌'}"
    )

    print(
        f"Git            "
        f"{'✅' if status['git']['installed'] else '❌'}"
    )

    print(
        f"Bash           "
        f"{'✅' if status['bash']['installed'] else '❌'}"
    )

    print(
        f"FreeRDP        "
        f"{'✅' if status['freerdp']['installed'] else '❌'} "
        f"{status['freerdp']['client'] or ''}"
    )

    pause()


def launch_desktop(
    distro_key: str,
    desktop_key: str
) -> None:

    if not DESKTOP_LAUNCHER.is_file():
        print(
            "ERROR: No existe desktop-launcher."
        )
        pause()
        return

    subprocess.run(
        [
            str(DESKTOP_LAUNCHER),
            distro_key,
            desktop_key
        ],
        check=False
    )


def installed_desktop_menu(
    distro_key: str,
    desktop_key: str
) -> None:

    distro = get_distro(
        distro_key
    )

    desktop = get_desktop(
        distro_key,
        desktop_key
    )

    container_name = desktop[
        "container"
    ]["name"]

    while True:

        container_status = get_status(
            container_name
        )

        header(
            f"{distro['name']} + "
            f"{desktop['name']}"
        )

        if container_status == "running":
            print("Estado: 🟢 Ejecutándose")
        else:
            print("Estado: 🟡 Detenido")

        print()

        options = [
            "▶ Iniciar / Abrir escritorio",
            "⏹ Detener",
            "📊 Ver estado",
            "🔄 Actualizar",
            "♻ Recrear contenedor",
            "🗑 Desinstalar",
            "🖥 Recrear acceso directo",
        ]

        choice = choose(options)

        if choice is None:
            return

        # ----------------------------------------------------
        # Iniciar / abrir
        # ----------------------------------------------------

        if choice == 0:

            launch_desktop(
                distro_key,
                desktop_key
            )

        # ----------------------------------------------------
        # Detener
        # ----------------------------------------------------

        elif choice == 1:

            if stop_container(
                container_name
            ):
                print(
                    "\n✓ Contenedor detenido."
                )
            else:
                print(
                    "\nERROR: No se pudo detener."
                )

            pause()

        # ----------------------------------------------------
        # Estado
        # ----------------------------------------------------

        elif choice == 2:

            print()
            print(
                f"Contenedor: {container_name}"
            )
            print(
                f"Estado: "
                f"{get_status(container_name)}"
            )

            pause()

        # ----------------------------------------------------
        # Actualizar
        # ----------------------------------------------------

        elif choice == 3:

            header(
                f"Actualizar "
                f"{distro['name']} + "
                f"{desktop['name']}"
            )

            print(
                "Buscando una imagen más reciente..."
            )
            print()

            try:

                result = update_desktop(
                    distro_key,
                    desktop_key
                )

                if result["changed"]:

                    print(
                        "✓ Hay una nueva imagen."
                    )

                    if result["recreated"]:
                        print(
                            "✓ Contenedor recreado."
                        )

                else:

                    print(
                        "✓ Ya tienes la versión más reciente."
                    )

            except InstallationError as error:

                print(
                    f"ERROR: {error}"
                )

            pause()

        # ----------------------------------------------------
        # Recrear
        # ----------------------------------------------------

        elif choice == 4:

            header(
                f"Recrear "
                f"{distro['name']} + "
                f"{desktop['name']}"
            )

            print(
                "⚠ Esta acción elimina y vuelve "
                "a crear el contenedor."
            )

            print()
            print(
                "Mientras no implementemos "
                "persistencia, los cambios hechos "
                "dentro del contenedor se perderán."
            )

            print()

            confirmation = input(
                "¿Continuar? [s/N]: "
            ).strip().lower()

            if confirmation not in {
                "s",
                "si",
                "sí",
                "y",
                "yes"
            }:
                print(
                    "\nOperación cancelada."
                )
                pause()
                continue

            try:

                recreate_desktop(
                    distro_key,
                    desktop_key
                )

                print()
                print(
                    "✓ Contenedor recreado correctamente."
                )

            except InstallationError as error:

                print()
                print(
                    f"ERROR: {error}"
                )

            pause()

        # ----------------------------------------------------
        # Desinstalar
        # ----------------------------------------------------

        elif choice == 5:

            header(
                f"Desinstalar "
                f"{distro['name']} + "
                f"{desktop['name']}"
            )

            print(
                "Se eliminará:"
            )
            print()
            print(
                "  - contenedor"
            )
            print(
                "  - acceso directo"
            )
            print()

            print(
                "La imagen Docker puede conservarse "
                "para reinstalar más rápido."
            )

            print()

            confirmation = input(
                "¿Desinstalar? [s/N]: "
            ).strip().lower()

            if confirmation not in {
                "s",
                "si",
                "sí",
                "y",
                "yes"
            }:
                print(
                    "\nOperación cancelada."
                )
                pause()
                continue

            print()

            remove_image_answer = input(
                "¿Eliminar también la imagen Docker? "
                "[s/N]: "
            ).strip().lower()

            remove_image_too = (
                remove_image_answer
                in {
                    "s",
                    "si",
                    "sí",
                    "y",
                    "yes"
                }
            )

            try:

                uninstall_desktop(
                    distro_key,
                    desktop_key,
                    remove_image_too=remove_image_too
                )

                print()
                print(
                    "✓ Escritorio desinstalado."
                )

                pause()

                return

            except InstallationError as error:

                print()
                print(
                    f"ERROR: {error}"
                )

                pause()

        # ----------------------------------------------------
        # Recrear acceso directo
        # ----------------------------------------------------

        elif choice == 6:

            shortcut = desktop.get(
                "shortcut",
                {}
            )

            name = shortcut.get(
                "name",
                f"{distro['name']} "
                f"{desktop['name']}"
            )

            path = create_shortcut(
                distro_key=distro_key,
                desktop_key=desktop_key,
                name=name
            )

            print()
            print(
                "✓ Acceso directo creado:"
            )
            print(
                path
            )

            pause()


def desktop_menu(
    distro_key: str,
    desktop_key: str
) -> None:

    distro = get_distro(
        distro_key
    )

    desktop = get_desktop(
        distro_key,
        desktop_key
    )

    installation = get_installation_status(
        distro_key,
        desktop_key
    )

    if installation == "unavailable":

        header(
            f"{distro['name']} + "
            f"{desktop['name']}"
        )

        print(
            "🚧 Esta combinación todavía "
            "no está disponible."
        )

        pause()

        return

    if installation == "installed":

        installed_desktop_menu(
            distro_key,
            desktop_key
        )

        return

    header(
        f"{distro['name']} + "
        f"{desktop['name']}"
    )

    if installation == "image-only":
        print(
            "Estado: 📦 Imagen descargada"
        )
    else:
        print(
            "Estado: 📥 No instalado"
        )

    print()

    choice = choose(
        [
            "📥 Instalar",
            "ℹ Información"
        ]
    )

    if choice is None:
        return

    if choice == 0:

        header(
            f"Instalando "
            f"{distro['name']} + "
            f"{desktop['name']}"
        )

        try:

            install_desktop(
                distro_key,
                desktop_key
            )

            pause()

        except (
            InstallationError,
            CatalogError
        ) as error:

            print()
            print(
                f"ERROR: {error}"
            )

            pause()

    elif choice == 1:

        print()
        print(
            f"Distribución: "
            f"{distro['name']}"
        )

        print(
            f"Escritorio: "
            f"{desktop['name']}"
        )

        print(
            f"Estado: "
            f"{status_label(distro_key, desktop_key)}"
        )

        if "image" in desktop:

            print(
                f"Imagen: "
                f"{desktop['image']['remote']}"
            )

        pause()


def distro_menu(
    distro_key: str
) -> None:

    distro = get_distro(
        distro_key
    )

    while True:

        desktop_keys = list(
            distro[
                "desktops"
            ].keys()
        )

        options = []

        for desktop_key in desktop_keys:

            desktop = distro[
                "desktops"
            ][desktop_key]

            options.append(
                f"{desktop['name']}  "
                f"{status_label(distro_key, desktop_key)}"
            )

        header(
            distro["name"]
        )

        choice = choose(
            options
        )

        if choice is None:
            return

        desktop_key = desktop_keys[
            choice
        ]

        desktop_menu(
            distro_key,
            desktop_key
        )


def distributions_menu() -> None:

    while True:

        distros = get_distros()

        distro_keys = list(
            distros.keys()
        )

        options = [
            distros[key]["name"]
            for key in distro_keys
        ]

        header(
            "Distribuciones"
        )

        choice = choose(
            options
        )

        if choice is None:
            return

        distro_menu(
            distro_keys[choice]
        )


def installed_menu() -> None:

    distros = get_distros()

    installed = []

    for distro_key, distro in distros.items():

        for desktop_key, desktop in distro[
            "desktops"
        ].items():

            status = get_installation_status(
                distro_key,
                desktop_key
            )

            if status == "installed":

                installed.append(
                    (
                        distro_key,
                        desktop_key,
                        f"{distro['name']} + "
                        f"{desktop['name']}  "
                        f"{status_label(distro_key, desktop_key)}"
                    )
                )

    header(
        "Escritorios instalados"
    )

    if not installed:

        print(
            "No hay escritorios instalados todavía."
        )

        pause()

        return

    options = [
        item[2]
        for item in installed
    ]

    choice = choose(
        options
    )

    if choice is None:
        return

    distro_key, desktop_key, _ = installed[
        choice
    ]

    installed_desktop_menu(
        distro_key,
        desktop_key
    )



def main() -> None:

    ensure_docker_group_session()

    while True:

        header()

        options = [
            "🐧 Distribuciones",
            "📦 Escritorios instalados",
            "🧰 Dependencias",
            "🔄 Actualizar administrador",
            "⚙ Configuración",
        ]

        choice = choose(
            options,
            back_text="Salir"
        )

        if choice is None:

            print()
            print(
                "Hasta luego."
            )

            return

        if choice == 0:

            distributions_menu()

        elif choice == 1:

            installed_menu()

        elif choice == 2:

            dependencies_menu()

        elif choice == 3:

            header(
                "Actualizar administrador"
            )

            print(
                "La actualización del repositorio "
                "se implementará en updater.py."
            )

            pause()

        elif choice == 4:

            header(
                "Configuración"
            )

            print(
                "El panel de configuración "
                "se implementará próximamente."
            )

            pause()


if __name__ == "__main__":

    try:

        main()

    except KeyboardInterrupt:

        print(
            "\nSaliendo..."
        )

    except CatalogError as error:

        print(
            f"\nERROR DE CATÁLOGO: {error}"
        )
