{
  "schema_version": 2,

  "project": {
    "name": "Linux Desktop Containers",
    "registry": "ghcr.io/fartavia3210-design/linux-desktop-containers"
  },

  "distros": {
    "arch": {
      "name": "Arch Linux",
      "desktops": {
        "xfce": {
          "name": "XFCE",
          "available": true,

          "image": {
            "remote": "ghcr.io/fartavia3210-design/linux-desktop-containers/arch-xfce:latest",
            "build_context": "distros/arch/xfce"
          },

          "container": {
            "name": "ldc-arch-xfce",
            "port": 3389,
            "host_port": "auto",
            "shm_size": "1g"
          },

          "rdp": {
            "user": "arch"
          },

          "security": {
            "seccomp": "common/security/seccomp-brave.json",
	    "apparmor": "linux-desktop-containers"
          },

          "shortcut": {
            "name": "Arch Linux XFCE"
          }
        },

        "kde": {
          "name": "KDE Plasma",
          "available": false
        },

        "gnome": {
